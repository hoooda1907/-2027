{
  "name": "rmt-system",
  "version": "1.0.0",
  "description": "RMT System - POS, purchases, inventory and accounting",
  "author": "RMT System",
  "main": "electron-main.js",
  "private": true,
  "scripts": {
    "prep": "node scripts/prep.js"
  },
  "dependencies": {
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.rmtsystem.pos",
    "productName": "RMT System",
    "files": [
      "electron-main.js",
      "electron-preload.js",
      "www/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "RMT System",
      "artifactName": "RMT-System-Setup.${ext}"
    },
    "portable": {
      "artifactName": "RMT-System-Portable.${ext}"
    }
  },
  "productName": "RMT System"
}